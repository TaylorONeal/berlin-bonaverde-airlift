{
  "expo": {
    "name": "Berlin Airlift",
    "slug": "berlin-airlift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.berlinairlift.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1F15",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.berlinairlift.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.NFC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "berlinairlift",
    "plugins": [
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Berlin Airlift uses NFC to read and write the cards your coffee machine takes.",
          "includeNdefEntitlement": false
        }
      ],
      "expo-font"
    ]
  }
}
